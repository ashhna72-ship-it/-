              <option value="avg5">(التقويم + الفرض1 + الفرض2 + الاختبار × 2) ÷ 5</option>
              <option value="avg3">(معدل المراقبة + الاختبار × 2) ÷ 3</option>
            </select>
          </div>

          <!-- الجدول المتجاوب -->
          <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
            <table class="w-full text-right border-collapse">
              <thead>
                <tr class="bg-slate-100/80 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 text-xs font-extrabold border-b border-slate-200 dark:border-slate-700">
                  <th class="py-3 px-3 min-w-[140px]">المادة</th>
                  <th class="py-3 px-2 w-20 text-center">المعامل</th>
                  <!-- أعمدة الوضع المفصل -->
                  <th class="py-3 px-2 w-20 text-center detailed-col hidden">تقويم</th>
                  <th class="py-3 px-2 w-20 text-center detailed-col hidden">فرض 1</th>
                  <th class="py-3 px-2 w-20 text-center detailed-col f2-col hidden">فرض 2</th>
                  <th class="py-3 px-2 w-20 text-center detailed-col hidden">اختبار</th>
                  <!-- عمود المعدل -->
                  <th class="py-3 px-2 w-24 text-center">المعدل /20</th>
                  <th class="py-3 px-2 w-20 text-center hidden sm:table-cell">المجموع</th>
                  <th class="py-3 px-2 w-10 text-center no-print">حذف</th>
                </tr>
              </thead>
              <tbody id="subjectsBody" class="divide-y divide-slate-100 dark:divide-slate-800 text-sm"></tbody>
            </table>
          </div>

          <!-- أزرار إدارة المواد -->
          <div class="flex flex-wrap items-center justify-between gap-2 mt-4 no-print">
            <div class="flex flex-wrap gap-2">
              <button type="button" id="addSubjectBtn" class="px-4 py-2 rounded-xl bg-blue-50 dark:bg-blue-950 text-dzBlue dark:text-blue-300 hover:bg-blue-100 font-bold text-xs flex items-center gap-1.5 transition">
                <i class="fa-solid fa-plus"></i> إضافة مادة
              </button>
              <button type="button" id="clearMarksBtn" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 font-bold text-xs flex items-center gap-1.5 transition">
                <i class="fa-solid fa-eraser"></i> تصفير العلامات
              </button>
            </div>
            <span id="validationHint" class="text-xs font-bold text-rose-600 dark:text-rose-400"></span>
          </div>
        </section>

        <!-- بطاقة النتيجة الفورية والتحليل (4 أعمدة) -->
        <aside class="lg:col-span-4 space-y-5 lg:sticky lg:top-4">
          
          <!-- بطاقة المعدل والتقدير -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm print-card">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-base font-extrabold text-dzNavy dark:text-blue-400">3. النتيجة الفورية</h2>
              <span id="mentionBadge" class="px-3 py-1 rounded-full text-xs font-extrabold bg-slate-100 dark:bg-slate-800 text-slate-500">في انتظار العلامات</span>
            </div>

            <div class="rounded-2xl bg-gradient-to-br from-blue-50 to-indigo-50/70 dark:from-slate-800 dark:to-slate-800/60 border border-blue-100 dark:border-slate-700 p-5 text-center">
              <div id="resultSubtitle" class="text-xs font-bold text-slate-500 dark:text-slate-400 mb-1">المعدل العام</div>
              <div id="averageDisplay" class="text-5xl font-black text-dzNavy dark:text-white tracking-tight my-1" dir="ltr">—</div>
              <div class="text-xs font-bold text-slate-400">من 20.00</div>

              <div class="grid grid-cols-3 gap-2 mt-4 pt-4 border-t border-blue-200/60 dark:border-slate-700 text-center">
                <div class="bg-white/80 dark:bg-slate-900/80 p-2 rounded-xl">
                  <div class="text-[11px] text-slate-500">المجموع</div>
                  <div id="totalWeighted" class="font-extrabold text-sm text-dzNavy dark:text-blue-300" dir="ltr">0</div>
                </div>
                <div class="bg-white/80 dark:bg-slate-900/80 p-2 rounded-xl">
                  <div class="text-[11px] text-slate-500">المعاملات</div>
                  <div id="totalCoeff" class="font-extrabold text-sm text-dzNavy dark:text-blue-300" dir="ltr">0</div>
                </div>
                <div class="bg-white/80 dark:bg-slate-900/80 p-2 rounded-xl">
                  <div class="text-[11px] text-slate-500">المواد</div>
                  <div id="validCount" class="font-extrabold text-sm text-dzNavy dark:text-blue-300">0</div>
                </div>
              </div>
            </div>

            <!-- أزرار الحفظ والطباعة -->
            <div class="grid grid-cols-2 gap-2 mt-4 no-print">
              <button type="button" id="saveResultBtn" class="px-3 py-2.5 rounded-xl bg-dzGreen hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-sm transition">
                <i class="fa-solid fa-bookmark"></i> حفظ في السجل
              </button>
              <button type="button" id="printBtn" class="px-3 py-2.5 rounded-xl bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-sm transition">
                <i class="fa-solid fa-print"></i> طباعة / PDF
              </button>
            </div>
          </section>

          <!-- بطاقة التحليل الذكي ونقاط القوة والضعف -->
          <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm no-print">
            <h3 class="text-sm font-extrabold text-dzNavy dark:text-blue-400 mb-3 flex items-center gap-2">
              <i class="fa-solid fa-magnifying-glass-chart text-dzBlue"></i> تحليل الأداء والمواد المؤثرة
            </h3>
            <div id="analysisBox" class="space-y-3 text-xs">
              <p class="text-slate-500 dark:text-slate-400">أدخل علاماتك ليظهر تحليل نقاط القوة والمواد ذات المعامل العالي التي تحتاج لتركيز أكبر.</p>
            </div>
          </section>

        </aside>
      </div>
    </div>

    <!-- ==================== التبويب 2: التقويم ومخطط الامتحانات ==================== -->
    <div id="tab-calendar" class="tab-content hidden space-y-6">
      
      <!-- العداد التنازلي للامتحانات الرسمية والفصلية -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <h2 class="text-lg font-extrabold text-dzNavy dark:text-blue-400 flex items-center gap-2">
            <i class="fa-solid fa-hourglass-half text-amber-500"></i> العداد التنازلي للامتحانات
          </h2>
          <span class="text-xs text-slate-500">يمكنك تعديل أي تاريخ حسب الرزنامة الوزارية</span>
        </di
