<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col">

  <!-- الرأس العلوي -->
  <header class="bg-gradient-to-bl from-[#0f294d] via-[#154c8a] to-[#1769aa] text-white shadow-lg">
    <div class="max-w-6xl mx-auto px-4 py-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-white/15 backdrop-blur-sm flex items-center justify-center text-2xl shadow-inner border border-white/20">
            🎓
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-2xl sm:text-3xl font-black tracking-tight">احسب معدلك DZ</h1>
              <span class="text-xs bg-emerald-500/20 text-emerald-200 border border-emerald-400/30 px-2 py-0.5 rounded-full font-bold">المنصة الشاملة</span>
            </div>
            <p class="text-blue-100 text-xs sm:text-sm mt-0.5">حاسبة المعدلات بالمعاملات الرسمية، تحليل النتائج، والتقويم الدراسي الجزائري</p>
          </div>
        </div>

        <!-- أزرار التحكم السريعة (الوضع الليلي + التنقل) -->
        <div class="flex items-center gap-2 no-print">
          <button id="darkModeToggle" type="button" aria-label="تبديل الوضع الليلي" class="p-2.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/15 transition flex items-center gap-2 text-sm font-bold">
            <i id="darkIcon" class="fa-solid fa-moon"></i>
            <span class="hidden sm:inline" id="darkText">الوضع الليلي</span>
          </button>
        </div>
