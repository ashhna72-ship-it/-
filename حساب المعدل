        </button>
        <button data-tab="calendar" class="tab-btn px-4 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2 transition whitespace-nowrap bg-white/10 text-white hover:bg-white/20">
          <i class="fa-solid fa-calendar-days"></i> التقويم ومخطط الامتحانات
        </button>
        <button data-tab="annual" class="tab-btn px-4 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2 transition whitespace-nowrap bg-white/10 text-white hover:bg-white/20">
          <i class="fa-solid fa-chart-line"></i> معدل السنة والهدف
        </button>
        <button data-tab="history" class="tab-btn px-4 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2 transition whitespace-nowrap bg-white/10 text-white hover:bg-white/20">
          <i class="fa-solid fa-clock-rotate-left"></i> سجل النتائج (<span id="historyBadge">0</span>)
        </button>
      </nav>
    </div>
  </header>

  <!-- إشعار عائم بدل alert() -->
  <div id="toast" class="fixed bottom-5 left-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none no-print">
    <div class="bg-slate-900 dark:bg-slate-800 text-white px-4 py-3 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3 text-sm font-bold">
      <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
      <span id="toastMsg">تم الحفظ بنجاح</span>
    </div>
  </div>

  <!-- المحتوى الرئيسي -->
  <main class="max-w-6xl mx-auto w-full px-4 py-6 flex-1">

    <!-- ==================== التبويب 1: حاسبة المعدل والتحليل ==================== -->
    <div id="tab-calculator" class="tab-content space-y-6">
      
      <!-- بطاقة اختيار المستوى والشعبة -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm print-card">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <h2 class="text-lg font-extrabold text-dzNavy dark:text-blue-400 flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-blue-100 dark:bg-blue-950 text-dzBlue flex items-center justify-center text-sm">1</span>
            المستوى الدراسي والشعبة (تحميل تلقائي للمعاملات)
          </h2>
          <span class="text-xs text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full">
            <i class="fa-solid fa-floppy-disk text-emerald-600 ml-1"></i> حفظ تلقائي للمسودة
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label for="level" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1.5">الطور / الشهادة</label>
            <select id="level" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none">
              <option value="ابتدائي">التعليم الابتدائي</option>
              <option value="متوسط" selected>التعليم المتوسط</option>
              <option value="ثانوي">التعليم الثانوي</option>
              <option value="BEM">شهادة التعليم المتوسط (BEM)</option>
              <option value="BAC">شهادة البكالوريا (BAC)</option>
            </select>
          </div>

          <div>
            <label for="year" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1.5">السنة الدراسية</label>
            <select id="year" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none"></select>
          </div>

          <div id="streamContainer">
            <label for="stream" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1.5">الشعبة</label>
            <select id="stream" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none"></select>
          </div>

          <div>
            <label for="period" class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-1.5">الفترة / الامتحان</label>
            <select id="period" class="w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-sm font-bold focus:ring-2 focus:ring-blue-500 outline-none">
              <option>الفصل الأول</option>
              <option>الفصل الثاني</option>
              <option>الفصل الثالث</option>
              <option>امتحان تجريبي</option>
              <option>امتحان رسمي نهائي</option>
            </select>
          </div>
        </div>

        <!-- خيارات إضافية للمواد الاختيارية واللغات -->
        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 no-print">
          <div class="flex flex-wrap items-center gap-4 text-xs font-bold">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="includeSport" checked class="w-4 h-4 rounded text-dzBlue focus:ring-blue-500">
              <span>احتساب التربية البدنية (معامل 1)</span>
            </label>
            <label id="artOptionWrap" class="inline-flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="includeArt" checked class="w-4 h-4 rounded text-dzBlue focus:ring-blue-500">
              <span>احتساب التربية الفنية/الموسيقية (معامل 1)</span>
            </label>
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="includeAmazigh" class="w-4 h-4 rounded text-dzBlue focus:ring-blue-500">
              <span>إضافة اللغة الأمازيغية</span>
            </label>
          </div>
          <button id="reloadOfficial" type="button" class="text-xs bg-blue-50 dark:bg-blue-950/60 text-dzBlue dark:text-blue-300 hover:bg-blue-100 px-3 py-1.5 rounded-lg font-bold transition">
            <i class="fa-solid fa-rotate ml-1"></i> إعادة ضبط المواد الرسمية
          </button>
        </div>
      </section>

      <!-- الشبكة الرئيسية: جدول المواد (يسار/يمين) + بطاقة النتيجة والتحليل -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- جدول المواد والعلامات (8 أعمدة) -->
        <section class="lg:col-span-8 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm print-card">
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-extrabold text-dzNavy dark:text-blue-400 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-100 dark:bg-blue-950 text-dzBlue flex items-center justify-center text-sm">2</span>
                كشف المواد والعلامات
              </h2>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">الحساب يتم تلقائياً وفورياً بمجرد إدخال أي علامة.</p>
            </div>

            <!-- زر التبديل بين الوضع المباشر والوضع المفصل -->
